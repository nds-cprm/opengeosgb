// Formato: https://containers.dev/implementors/json_reference/
// O container do django roda sem root (user 1000:0, do docker-compose.opengeosgb.yml): o VS Code
// Server fica no HOME do usuário e o código em ./src (bind mount).
{
	"name": "opengeosgb (django)",

	// Mesma combinação do geonode-docker (opengeosgb-alias.sh), mais o override do Dev Container
	"dockerComposeFile": [
		"../docker-compose.yml",
		"../docker-compose.opengeosgb.yml",
		"docker-compose.yml"
	],

	"service": "django",

	"workspaceFolder": "/usr/src/project/",

	// Para a stack ao fechar o VS Code; para mantê-la de pé, troque por "none".
	"shutdownAction": "stopCompose",

	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.profiles.linux": {
					"bash": {
						"path": "/bin/bash",
						"args": ["-l"]
					}
				},
				"terminal.integrated.defaultProfile.linux": "bash"
			},
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.flake8",
				"batisteo.vscode-django",
				"mrorz.language-gettext",
				"eamodio.gitlens", // Note: User preference
				"bigonesystems.django" // Note: User preference
			]
		}
	},

	"forwardPorts": [8000, 8080, 5432, 5678]
}
